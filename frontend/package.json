{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "axios": "^1.7.9",
    "chart.js": "^4.4.8",
    "cra-template": "1.2.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.29.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.15.1",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "scss": "sass scss/main.scss public/css/styles.css --watch",
    "scss:build": "sass scss/main.scss public/css/styles.css --style=compressed",
    "build:css": "npx tailwindcss build src/index.css -o src/tailwind.css",
    "watch:css": "npx tailwindcss build src/index.css -o src/tailwind.css --watch"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "sass": "^1.86.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
